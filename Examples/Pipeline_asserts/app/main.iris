module pipeline_asserts;

// Each test breaks a precondition of a pipeline expansion or of a Fixed_capacity_array operation,
// so the check it emits must stop the test. They are expected to fail.

@test
function test_inputs_of_different_lengths() -> ()
{
    var values: Constant_array::<Int32, 3> = [1, 2, 3];
    var weights: Constant_array::<Int32, 2> = [4, 5];

    pipeline weighted(value: Int32, weight: Int32)
    {
        map value * weight => product;
    }

    mutable sum = 0;
    for product in weighted(values, weights)
    {
        sum += product;
    }

    check(sum == 14);
}

@test
function test_an_into_buffer_that_is_too_small() -> ()
{
    var values: Constant_array::<Int32, 3> = [1, 2, 3];
    mutable storage: Constant_array::<Int32, 2> = [0, 0];
    var first: *mutable Int32 = &storage[0];
    var buffer = create_array_slice_from_pointer(first, 2u64);

    pipeline plus_one(value: Int32)
    {
        map value + 1 => next;
    }

    var written = plus_one(values).into(buffer);
    check(written.length == 3u64);
}

@test
function test_a_scratch_buffer_that_is_too_small() -> ()
{
    var values: Constant_array::<Int32, 3> = [1, 2, 3];
    mutable storage: Constant_array::<Float32, 3> = [0.0f32, 0.0f32, 0.0f32];
    var first: *mutable Float32 = &storage[0];
    var buffer = create_array_slice_from_pointer(first, 3u64);
    mutable scratch_storage: Constant_array::<Int32, 2> = [0, 0];
    var scratch_first: *mutable Int32 = &scratch_storage[0];
    var scratch = create_array_slice_from_pointer(scratch_first, 2u64);

    pipeline doubled_as_float(value: Int32)
    {
        map value * 2 => doubled;
        map doubled as Float32 => result;
    }

    var written = doubled_as_float(values).separate(scratch).into(buffer);
    check(written.length == 3u64);
}

@test
function test_a_large_enough_buffer() -> ()
{
    var values: Constant_array::<Int32, 3> = [1, 2, 3];
    mutable storage: Constant_array::<Int32, 3> = [0, 0, 0];
    var first: *mutable Int32 = &storage[0];
    var buffer = create_array_slice_from_pointer(first, 3u64);

    pipeline plus_one(value: Int32)
    {
        map value + 1 => next;
    }

    var written = plus_one(values).into(buffer);
    check(written.length == 3u64);
}

@test
function test_a_push_on_a_full_fixed_capacity_array() -> ()
{
    mutable values: Fixed_capacity_array::<Int32, 2> = {};
    values.push(1);
    values.push(2);
    values.push(3);
    check(values.length == 3u64);
}

@test
function test_a_pop_on_an_empty_fixed_capacity_array() -> ()
{
    mutable values: Fixed_capacity_array::<Int32, 2> = {};
    var value = values.pop();
    check(value == 0);
}

@test
function test_an_index_past_the_length_of_a_fixed_capacity_array() -> ()
{
    mutable values: Fixed_capacity_array::<Int32, 4> = {};
    values.push(1);
    check(values[1] == 0);
}

@unique_name("main")
export function main() -> (result: Int32)
{
    return 0;
}
