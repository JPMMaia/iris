module pipeline_asserts;

// Each test breaks a precondition of a pipeline expansion, so the inline assert it emits must stop
// the test. They are expected to fail.

@test
function test_inputs_of_different_lengths() -> ()
{
    var values: Constant_array::<Int32, 3> = [1, 2, 3];
    var weights: Constant_array::<Int32, 2> = [4, 5];

    pipeline weighted(value: Int32, weight: Int32)
    {
        map value * weight => product;
    }

    mutable sum = 0;
    for product in weighted(values, weights)
    {
        sum += product;
    }

    check(sum == 14);
}

@test
function test_an_into_buffer_that_is_too_small() -> ()
{
    var values: Constant_array::<Int32, 3> = [1, 2, 3];
    mutable storage: Constant_array::<Int32, 2> = [0, 0];
    var first: *mutable Int32 = &storage[0];
    var buffer = create_array_slice_from_pointer(first, 2u64);

    pipeline plus_one(value: Int32)
    {
        map value + 1 => next;
    }

    var written = plus_one(values).into(buffer);
    check(written.length == 3u64);
}

@test
function test_a_large_enough_buffer() -> ()
{
    var values: Constant_array::<Int32, 3> = [1, 2, 3];
    mutable storage: Constant_array::<Int32, 3> = [0, 0, 0];
    var first: *mutable Int32 = &storage[0];
    var buffer = create_array_slice_from_pointer(first, 3u64);

    pipeline plus_one(value: Int32)
    {
        map value + 1 => next;
    }

    var written = plus_one(values).into(buffer);
    check(written.length == 3u64);
}

@unique_name("main")
export function main() -> (result: Int32)
{
    return 0;
}
