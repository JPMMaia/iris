module Comment_switch_expressions;

export function run_switch(value: Int32) -> (result: Int32)
{
    switch value
    {
    case 0:
        // The zero case.
        return 0;
    case 1:
        // Two comment lines.
        // The second one.
        return 1;
    default:
        // Anything else.
        return 2;
    }
}
