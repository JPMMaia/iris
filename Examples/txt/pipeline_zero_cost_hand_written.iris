module Pipeline_zero_cost_hand_written;

// The loops that the functions of pipeline_zero_cost.iris are written as pipelines for.

struct Particle
{
    x: Float32 = 0.0f32;
    y: Float32 = 0.0f32;
    z: Float32 = 0.0f32;
}

export function sum_of_even_squares(values: Array_slice::<Int32>) -> (result: Int32)
{
    mutable sum = 0;
    for index in 0u64 to values.length
    {
        var value = values[index];
        if value % 2 == 0
        {
            sum += value * value;
        }
    }
    return sum;
}

export function weighted_sum(values: Array_slice::<Float32>, weights: Array_slice::<Float32>) -> (result: Float32)
{
    assert "Pipeline inputs have equal length" { weights.length == values.length };

    mutable total = 0.0f32;
    for index in 0u64 to values.length
    {
        total = total + values[index] * weights[index];
    }
    return total;
}

export function count_large(values: Array_slice::<Int32>, threshold: Int32) -> (result: Uint64)
{
    mutable count = 0u64;
    for index in 0u64 to values.length
    {
        if values[index] > threshold
        {
            count += 1u64;
        }
    }
    return count;
}

export function any_negative(values: Array_slice::<Int32>) -> (result: Bool)
{
    for index in 0u64 to values.length
    {
        if values[index] < 0
        {
            return true;
        }
    }
    return false;
}

export function keep_positive(values: Array_slice::<mutable Int32>) -> (result: Array_slice::<mutable Int32>)
{
    mutable count = 0u64;
    for index in 0u64 to values.length
    {
        var value = values[index];
        if value > 0
        {
            values[count] = value;
            count += 1u64;
        }
    }
    return create_array_slice_from_pointer(values.data, count);
}

// Reads the fields it uses at the top of the iteration, which is what the pipeline is defined to do.
// Reading x inside the if instead optimizes to the same instructions without bounds checks, but with
// them the checks land in different blocks.
export function sum_of_x(particles: Soa_array_view::<Particle>) -> (result: Float32)
{
    mutable sum = 0.0f32;
    for index in 0u64 to particles.length
    {
        var y = particles->y[index];
        var x = particles->x[index];
        if y > 0.0f32
        {
            sum += x;
        }
    }
    return sum;
}

export function sum_of_moving_z(particles: Array_slice::<Particle>) -> (result: Float32)
{
    mutable sum = 0.0f32;
    for index in 0u64 to particles.length
    {
        var particle = &particles[index];
        if particle->y > 0.0f32
        {
            sum += particle->z;
        }
    }
    return sum;
}

function add_cube(total: Int32, value: Int32) -> (result: Int32)
{
    return total + value * value * value;
}

export function sum_of_odd_cubes(values: Array_slice::<Int32>) -> (result: Int32)
{
    mutable total = 0;
    for index in 0u64 to values.length
    {
        var value = values[index];
        if value % 2 != 0
        {
            total = add_cube(total, value);
        }
    }
    return total;
}

export function odd_squares(values: Constant_array::<Int32, 8>) -> (result: Fixed_capacity_array::<Int32, 8>)
{
    mutable squares: Fixed_capacity_array::<Int32, 8> = {};
    for index in 0u64 to 8u64
    {
        var value = values[index];
        if value % 2 == 1
        {
            squares.push(value * value);
        }
    }
    return squares;
}
