module Reinterpret_as;

function run(data: *Void) -> ()
{
    var converted = reinterpret_as::<*Uint32>(data);
    var address = reinterpret_as::<Uint64>(data);
    var pointer = reinterpret_as::<*Void>(address);
    var bits = reinterpret_as::<Uint32>(1.0f32);
    var number = reinterpret_as::<Float32>(bits);
}
