module views;

// view(start, end) narrows a Soa_array, a Soa_array_view or an Array_slice to the elements from start
// to end. Indices are relative to the receiver, and a view's length is end - start.

struct Particle
{
    x: Float32 = 0.0f32;
    y: Float32 = 0.0f32;
}

function sum_x(particles: Soa_array_view::<Particle>) -> (result: Float32)
{
    mutable sum = 0.0f32;
    for index in 0u64 to particles.length
    {
        sum += particles->x[index];
    }
    return sum;
}

function sum_of_slice(values: Array_slice::<Int32>) -> (result: Int32)
{
    mutable sum = 0;
    for index in 0u64 to values.length
    {
        sum += values[index];
    }
    return sum;
}

function fill(all: Soa_array_view::<mutable Particle>) -> ()
{
    for index in 0u64 to all.length
    {
        all[index] = { x: (index as Float32) + 1.0f32, y: 0.0f32 };
    }
}

@test
function test_a_soa_array_view_covers_end_minus_start_elements() -> ()
{
    mutable particles: Soa_array::<Particle, 6> = [];
    fill(particles.view());

    var middle: Soa_array_view::<mutable Particle> = particles.view(1, 3);
    check(middle.length == 2u64);
    check(middle.start_index == 1u64);
    check(middle.end_index == 3u64);
    check(middle->x[0] == 2.0f32);
    check(sum_x(middle) == 5.0f32);
}

@test
function test_a_view_of_a_soa_array_view() -> ()
{
    mutable particles: Soa_array::<Particle, 6> = [];
    fill(particles.view());

    var all: Soa_array_view::<mutable Particle> = particles.view();
    var live = all.view(0u64, 4u64);
    check(live.length == 4u64);
    check(sum_x(live) == 10.0f32);

    var inner = live.view(1u64, 3u64);
    check(inner.length == 2u64);
    check(inner.start_index == 1u64);
    check(inner->x[0] == 2.0f32);
    check(inner[1].x == 3.0f32);
    check(sum_x(inner) == 5.0f32);

    var empty = live.view(2u64, 2u64);
    check(empty.length == 0u64);
    check(sum_x(empty) == 0.0f32);
}

@test
function test_writes_through_a_soa_sub_view_land_in_the_right_rows() -> ()
{
    mutable particles: Soa_array::<Particle, 6> = [];
    fill(particles.view());

    var all: Soa_array_view::<mutable Particle> = particles.view();
    var inner = all.view(2u64, 4u64);
    inner->y[0] = 30.0f32;
    inner[1] = { x: 40.0f32, y: 40.0f32 };

    check(all->y[2] == 30.0f32);
    check(all->x[3] == 40.0f32);
    check(all->y[3] == 40.0f32);
    check(all->y[4] == 0.0f32);
}

@test
function test_a_view_takes_any_unsigned_integer_bounds() -> ()
{
    mutable particles: Soa_array::<Particle, 6> = [];
    fill(particles.view());

    var all: Soa_array_view::<mutable Particle> = particles.view();
    var count = 3u32;
    var live = all.view(0u64, count as Uint64);
    check(live.length == 3u64);
}

@test
function test_a_view_of_an_array_slice() -> ()
{
    var values: Constant_array::<Int32, 5> = [1, 2, 3, 4, 5];
    var slice: Array_slice::<Int32> = values;

    var middle = slice.view(1u64, 4u64);
    check(middle.length == 3u64);
    check(middle[0] == 2);
    check(sum_of_slice(middle) == 9);

    var inner = middle.view(1u64, 2u64);
    check(inner.length == 1u64);
    check(inner[0] == 3);

    var empty = slice.view(5u64, 5u64);
    check(empty.length == 0u64);
    check(sum_of_slice(empty) == 0);
}

@test
function test_writes_through_a_mutable_slice_view() -> ()
{
    mutable values: Constant_array::<Int32, 4> = [1, 2, 3, 4];
    var slice: Array_slice::<mutable Int32> = values;

    var tail = slice.view(2u64, 4u64);
    tail[0] = 30;
    check(values[2] == 30);
}

@unique_name("main")
export function main() -> (result: Int32)
{
    return 0;
}
